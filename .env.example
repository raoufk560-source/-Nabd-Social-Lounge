# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used for signing session tokens and cookies
SESSION_SECRET="change_this_to_a_secure_random_secret_in_production"

# SQLITE_DB_PATH: Path to the relational SQLite database file
SQLITE_DB_PATH="./data/nabd_social.sqlite"

# UPLOADS_DIR: Directory for storing user uploaded media files (avatars, banners, stories, reels, voice clips)
UPLOADS_DIR="./uploads"

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET: Optional credentials for Google OAuth sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# WebRTC TURN Server Configuration (Optional - Required only for strict Symmetric NAT / corporate firewalls)
TURN_URL=""
TURN_USERNAME=""
TURN_PASSWORD=""


